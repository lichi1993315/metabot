# Non-secret Azure notify-only process contract.
METABOT_NOTIFY_ONLY=true
API_PORT=9100
BOTS_CONFIG=/home/azureadmin/metabot/bots.json
METABOT_DEFAULT_ENV_FILE=/etc/metabot/notify-only.env

# Store API_SECRET and any bot credentials only in the root-owned default env
# file or /home/azureadmin/metabot/.env. Do not place values in this example.
